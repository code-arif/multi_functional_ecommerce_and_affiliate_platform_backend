    {
      "name": "2. Customer Upgrade to Vendor (Path 2)",
      "item": [
        {
          "name": "Customer Applies to Become a Vendor (Sell on Platform)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res && res.data && res.data.uuid) {",
                  "    pm.collectionVariables.set('vendor_uuid', res.data.uuid);",
                  "    console.log('Vendor UUID saved:', res.data.uuid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shop_name\": \"John Gadgets Store\",\n  \"phone\": \"+8801711000001\",\n  \"description\": \"Authorized gadgets and smart devices store\",\n  \"business_type\": \"Sole Proprietorship\",\n  \"business_registration_number\": \"TRAD/DNCC/123456/2026\",\n  \"tax_id\": \"TIN-9876543210\",\n  \"website\": \"https://johngadgets.com\",\n  \"address_line_1\": \"Level 3, Multiplan Center\",\n  \"city\": \"Dhaka\",\n  \"state\": \"Dhaka\",\n  \"postal_code\": \"1205\",\n  \"country\": \"Bangladesh\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/vendor/apply",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vendor", "apply"]
            },
            "description": "Path 2: Logged-in customer upgrades to vendor without needing new credentials. Application status is set to 'pending' awaiting admin review."
          }
        }
      ]
    },
    {
      "name": "3. Vendor Portal (Profile & KYC Documents)",
      "item": [
        {
          "name": "Get Vendor Shop Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/vendor/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vendor", "profile"]
            },
            "description": "Fetch the authenticated vendor's full shop profile, addresses, bank accounts, and documents."
          }
        },
        {
          "name": "Update Vendor Shop Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shop_name\": \"Sarah Fashion House Updated\",\n  \"description\": \"Updated store description with exclusive collections.\",\n  \"business_type\": \"Registered LLC\",\n  \"website\": \"https://sarahfashion.com\",\n  \"return_policy\": \"7 days easy return\",\n  \"shipping_policy\": \"Delivered within 48 hours in Dhaka\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/vendor/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vendor", "profile"]
            },
            "description": "Update vendor shop profile."
          }
        },
        {
          "name": "Upload KYC Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('document_id', res.data.id);",
                  "    console.log('Document ID saved:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "type", "value": "trade_license", "type": "text" },
                { "key": "document_number", "value": "TL-2026-9988", "type": "text" },
                { "key": "expiry_date", "value": "2027-12-31", "type": "text" },
                { "key": "document", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/vendor/documents",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vendor", "documents"]
            },
            "description": "Upload Trade License, NID, BIN, or TIN for admin KYC verification."
          }
        },
        {
          "name": "List KYC Documents",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/vendor/documents",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vendor", "documents"]
            },
            "description": "View all uploaded KYC documents and their verification status (pending, verified, rejected)."
          }
        }
      ]
    },
    {
      "name": "4. Admin Vendor Moderation (Review & Approval)",
      "item": [
        {
          "name": "List All Vendors (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res && res.data && res.data.length > 0 && res.data[0].uuid) {",
                  "    pm.collectionVariables.set('vendor_uuid', res.data[0].uuid);",
                  "    console.log('Admin: First vendor UUID saved:', res.data[0].uuid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/vendors?status=pending",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "vendors"],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "search", "value": "", "disabled": true }
              ]
            },
            "description": "Admin lists vendors filtered by status (pending, active, suspended, rejected)."
          }
        },
        {
          "name": "Get Vendor Details with KYC (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/vendors/{{vendor_uuid}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "vendors", "{{vendor_uuid}}"]
            },
            "description": "Admin inspects full vendor record, owner details, KYC documents, and bank info."
          }
        },
        {
          "name": "Verify Vendor Document (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/vendors/documents/{{document_id}}/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "vendors", "documents", "{{document_id}}", "verify"]
            },
            "description": "Admin marks a specific KYC document as verified."
          }
        },
        {
          "name": "Approve Vendor (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/vendors/{{vendor_uuid}}/approve",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "vendors", "{{vendor_uuid}}", "approve"]
            },
            "description": "Admin approves vendor. Status changes to 'active', vendor receives notification and can start publishing products."
          }
        },
        {
          "name": "Reject Vendor Application (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Invalid trade license image. Please upload a clear scanned copy of your valid 2026 license.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/vendors/{{vendor_uuid}}/reject",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "vendors", "{{vendor_uuid}}", "reject"]
            },
            "description": "Admin rejects vendor application with a specific reason."
          }
        },
        {
          "name": "Suspend Vendor (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Multiple customer counterfeit product complaints under dispute investigation.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/vendors/{{vendor_uuid}}/suspend",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "vendors", "{{vendor_uuid}}", "suspend"]
            },
            "description": "Admin suspends an active vendor."
          }
        }
      ]
    },
