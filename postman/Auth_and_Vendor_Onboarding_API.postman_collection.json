    },
    {
      "key": "device_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Public Auth & Registration",
      "item": [
        {
          "name": "Customer Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('customer_token', res.data.token);",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Customer token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Customer\",\n  \"email\": \"customer@example.com\",\n  \"phone\": \"+8801711000001\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/user/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "user", "register"]
            },
            "description": "Public customer registration."
          }
        },
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('customer_token', res.data.token);",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Customer token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123!\",\n  \"device_name\": \"Postman / Apidog\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/user/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "user", "login"]
            },
            "description": "Customer login."
          }
        },
        {
          "name": "Vendor Self-Registration (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('vendor_token', res.data.token);",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    if (res.data.shop && res.data.shop.uuid) {",
                  "        pm.collectionVariables.set('vendor_uuid', res.data.shop.uuid);",
                  "    }",
                  "    console.log('Vendor token & UUID saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Merchant\",\n  \"email\": \"merchant@example.com\",\n  \"phone\": \"+8801722000002\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\",\n  \"shop_name\": \"Sarah Fashion House\",\n  \"business_type\": \"Individual / Private\",\n  \"description\": \"Premium fashion and lifestyle products\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/vendor/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "vendor", "register"]
            },
            "description": "Path 1: Public self-registration for new vendors. Creates user, assigns vendor role, creates shop with status 'pending'."
          }
        },
