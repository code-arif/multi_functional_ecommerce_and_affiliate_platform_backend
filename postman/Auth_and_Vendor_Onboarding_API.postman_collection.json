{
  "info": {
    "_postman_id": "b3e921d7-8395-4654-9a25-c6198f1fbe14",
    "name": "Auth & Vendor Onboarding API (EcoShop)",
    "description": "Complete collection for Auth & Multi-Vendor Onboarding flows in Modules/Auth and Modules/Vendor.\nCompatible with Postman and Apidog.\n\n### Included Workflows:\n1. Customer Registration & Login\n2. New Vendor Self-Registration (Public)\n3. Existing Customer Upgrade to Vendor (Sell on Platform / Apply)\n4. Vendor KYC Document Upload & Shop Profile\n5. Admin Vendor Moderation (Review, Approve, Reject, Suspend)\n6. Passwordless OTP Auth (Admin & Vendor)\n7. Address Book & Device Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "vendor_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "otp_code",
      "value": "123456",
      "type": "string"
    },
    {
      "key": "vendor_uuid",
      "value": "",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "1",
      "type": "string"
    },
